          <mxGeometry x="30" y="20" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="life0" value="" style="html=1;endArrow=block;fontSize=10;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
