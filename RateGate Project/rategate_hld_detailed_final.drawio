        <mxCell id="t0" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=2;fontSize=10;sketch=1;curveFitting=1;jiggle=1;" value="Match the path to a backend service" vertex="1">
