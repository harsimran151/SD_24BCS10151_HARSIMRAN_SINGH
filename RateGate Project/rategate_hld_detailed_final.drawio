        </mxCell>
        <mxCell id="r3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=2;fontSize=10;sketch=1;curveFitting=1;jiggle=1;" value="Token available? Take 1 and allow" vertex="1">
