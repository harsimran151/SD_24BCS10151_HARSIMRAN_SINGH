          <mxGeometry x="390" y="20" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="life2" value="" style="html=1;endArrow=block;fontSize=10;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="450" y="60" as="sourcePoint" />
            <mxPoint x="450" y="700" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="h3" value="Rate Limiter" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="570" y="20" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="life3" value="" style="html=1;endArrow=block;fontSize=10;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="630" y="60" as="sourcePoint" />
            <mxPoint x="630" y="700" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="h4" value="Redis" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="750" y="20" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="life4" value="" style="html=1;endArrow=block;fontSize=10;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="810" y="60" as="sourcePoint" />
            <mxPoint x="810" y="700" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="h5" value="Router + Breaker" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="930" y="20" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="life5" value="" style="html=1;endArrow=block;fontSize=10;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="990" y="60" as="sourcePoint" />
            <mxPoint x="990" y="700" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="h6" value="Backend" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1110" y="20" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="life6" value="" style="html=1;endArrow=block;fontSize=10;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1170" y="60" as="sourcePoint" />
            <mxPoint x="1170" y="700" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="h7" value="Message Queue" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1290" y="20" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="life7" value="" style="html=1;endArrow=block;fontSize=10;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1350" y="60" as="sourcePoint" />
            <mxPoint x="1350" y="700" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m1" value="1. request + API key" style="html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="90" y="110" as="sourcePoint" />
            <mxPoint x="270" y="110" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m2" value="2. send to one gateway instance" style="html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="270" y="150" as="sourcePoint" />
            <mxPoint x="450" y="150" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m3" value="3. key valid, policy loaded" style="html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="450" y="190" as="sourcePoint" />
            <mxPoint x="630" y="190" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m4" value="4. token-bucket check (atomic)" style="html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="630" y="230" as="sourcePoint" />
            <mxPoint x="810" y="230" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m5" value="5. token taken / none left" style="html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="810" y="270" as="sourcePoint" />
            <mxPoint x="630" y="270" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m6" value="6. allowed" style="html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="630" y="310" as="sourcePoint" />
            <mxPoint x="990" y="310" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m7" value="7. forward to healthy server (breaker Closed)" style="html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="990" y="350" as="sourcePoint" />
            <mxPoint x="1170" y="350" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m8" value="8. response" style="html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1170" y="390" as="sourcePoint" />
            <mxPoint x="990" y="390" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m9" value="9. response returned to client" style="html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="990" y="430" as="sourcePoint" />
            <mxPoint x="90" y="430" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m10" value="10. async event: client, route, status, time" style="html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#9673a6;fontColor=#9673a6;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="990" y="470" as="sourcePoint" />
            <mxPoint x="1350" y="470" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="failhead" value="Failure cases (request stops early)" style="html=1;whiteSpace=wrap;text;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="90" y="510" width="400" height="30" as="geometry" />
        </mxCell>
        <mxCell id="m11" value="401 / 403 if the key is invalid or blocked" style="html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="450" y="560" as="sourcePoint" />
            <mxPoint x="90" y="560" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m12" value="429 + Retry-After if no tokens are left" style="html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="630" y="600" as="sourcePoint" />
            <mxPoint x="90" y="600" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m13" value="503 if every server&#39;s breaker is Open" style="html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="990" y="640" as="sourcePoint" />
            <mxPoint x="90" y="640" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="note2" value="Steps 1–9 are the request path and must stay under 10 ms added delay (p95). Step 10 happens after the response, so it never slows the client." style="html=1;whiteSpace=wrap;rounded=1;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="90" y="715" width="900" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p3" name="3. Algorithms">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t1" value="Token Bucket (Rate Limiter)" style="html=1;whiteSpace=wrap;text;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="500" height="30" as="geometry" />
        </mxCell>
        <mxCell id="tb0" value="Request arrives&lt;br&gt;(client_id + route)" style="html=1;whiteSpace=wrap;ellipse;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="100" y="55" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="tb1" value="Refill: tokens = min(burst, tokens + seconds since last refill × rate)" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="135" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="tb2" value="tokens ≥ 1 ?" style="html=1;whiteSpace=wrap;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="225" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="tb3" value="tokens = tokens − 1&lt;br&gt;save back to Redis" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="360" width="240" height="55" as="geometry" />
        </mxCell>
        <mxCell id="tb4" value="ALLOW → send to Router" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#82b366;strokeColor=#2d7600;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="445" width="200" height="45" as="geometry" />
        </mxCell>
        <mxCell id="tb5" value="REJECT → 429 Too Many Requests&lt;br&gt;+ Retry-After header" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="370" y="245" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="tbe0" value="" style="html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="tb0" target="tb1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tbe1" value="" style="html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="tb1" target="tb2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tbe2" value="Yes" style="html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="tb2" target="tb3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tbe3" value="No" style="html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="tb2" target="tb5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tbe4" value="" style="html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="tb3" target="tb4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tbex" value="&lt;b&gt;Example:&lt;/b&gt; burst = 10, rate = 1 token per second&lt;br&gt;• Client was idle → bucket is full (10)&lt;br&gt;• 10 requests at once → all allowed, bucket is empty&lt;br&gt;• 11th request right away → 429&lt;br&gt;• 1 second later → 1 token is back → next request allowed&lt;br&gt;&lt;b&gt;Why this algorithm:&lt;/b&gt; short bursts are fine, long-term rate stays fair, and it needs only 2 numbers per client (tokens, last refill time)." style="html=1;whiteSpace=wrap;rounded=1;fillColor=#fffbe6;strokeColor=#d6b656;align=left;spacing=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="530" width="560" height="150" as="geometry" />
        </mxCell>
        <mxCell id="t2" value="Circuit Breaker (per backend server)" style="html=1;whiteSpace=wrap;text;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="760" y="10" width="500" height="30" as="geometry" />
        </mxCell>
        <mxCell id="cb1" value="CLOSED&lt;br&gt;(normal)" style="html=1;whiteSpace=wrap;ellipse;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="760" y="80" width="160" height="90" as="geometry" />
        </mxCell>
        <mxCell id="cb2" value="OPEN&lt;br&gt;(blocked)" style="html=1;whiteSpace=wrap;ellipse;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1160" y="80" width="160" height="90" as="geometry" />
        </mxCell>
        <mxCell id="cb3" value="HALF-OPEN&lt;br&gt;(testing)" style="html=1;whiteSpace=wrap;ellipse;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="960" y="330" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="cbe1" value="failures reach the limit (example: 5 in a row)" style="html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="cb1" target="cb2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cbe2" value="after a wait time (example: 30 s)" style="html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="cb2" target="cb3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cbe3" value="test requests succeed" style="html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="cb3" target="cb1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cbe4" value="a test request fails" style="html=1;endArrow=block;fontSize=10;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="cb3" target="cb2">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1370" y="375" />
              <mxPoint x="1370" y="125" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="cbn1" value="&lt;b&gt;Closed:&lt;/b&gt; all requests go through; failures are counted." style="html=1;whiteSpace=wrap;rounded=1;fillColor=#fffbe6;strokeColor=#d6b656;align=left;spacing=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="700" y="470" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="cbn2" value="&lt;b&gt;Open:&lt;/b&gt; no requests are sent to this server; the router uses another server right away." style="html=1;whiteSpace=wrap;rounded=1;fillColor=#fffbe6;strokeColor=#d6b656;align=left;spacing=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="940" y="470" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="cbn3" value="&lt;b&gt;Half-Open:&lt;/b&gt; only a few test requests are allowed to see if the server has recovered." style="html=1;whiteSpace=wrap;rounded=1;fillColor=#fffbe6;strokeColor=#d6b656;align=left;spacing=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1180" y="470" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="cbn4" value="The numbers (5 failures, 30 seconds) are example values; tune them for your project." style="html=1;whiteSpace=wrap;text;fontSize=10;fontStyle=2;align=left;" vertex="1" parent="1">
          <mxGeometry x="700" y="570" width="700" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p4" name="4. Failure handling">
    <mxGraphModel dx="981" dy="535" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="720" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t4" parent="1" style="html=1;whiteSpace=wrap;text;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontSize=16;" value="What happens when something breaks?" vertex="1">
          <mxGeometry height="30" width="600" x="40" y="10" as="geometry" />
        </mxCell>
        <mxCell id="hd40" parent="1" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" value="Scenario" vertex="1">
          <mxGeometry height="40" width="230" x="40" y="55" as="geometry" />
        </mxCell>
        <mxCell id="hd290" parent="1" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" value="What the system sees" vertex="1">
          <mxGeometry height="40" width="350" x="290" y="55" as="geometry" />
        </mxCell>
        <mxCell id="hd660" parent="1" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" value="How the design handles it" vertex="1">
          <mxGeometry height="40" width="690" x="660" y="55" as="geometry" />
        </mxCell>
        <mxCell id="r0_40" parent="1" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacing=6;fontSize=11;fontStyle=1;" value="Redis is down or slow" vertex="1">
          <mxGeometry height="70" width="230" x="40" y="105" as="geometry" />
        </mxCell>
        <mxCell id="r0_290" parent="1" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacing=6;fontSize=11;" value="Gateway cannot read or update token counts" vertex="1">
          <mxGeometry height="70" width="350" x="290" y="105" as="geometry" />
        </mxCell>
        <mxCell id="r0_660" parent="1" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacing=6;fontSize=11;" value="Choose a rule and state it: fail-open (let requests through, favours availability) or fail-closed (block, favours protecting backends). Use a Redis replica and a short timeout so latency stays low." vertex="1">
          <mxGeometry height="70" width="690" x="660" y="105" as="geometry" />
        </mxCell>
        <mxCell id="r1_40" parent="1" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacing=6;fontSize=11;fontStyle=1;" value="One gateway instance crashes" vertex="1">
          <mxGeometry height="70" width="230" x="40" y="185" as="geometry" />
        </mxCell>
        <mxCell id="r1_290" parent="1" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacing=6;fontSize=11;" value="Its share of traffic fails for a moment" vertex="1">
          <mxGeometry height="70" width="350" x="290" y="185" as="geometry" />
        </mxCell>
        <mxCell id="r1_660" parent="1" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacing=6;fontSize=11;" value="The load balancer&#39;s health check removes it; other instances keep serving. Counters live in Redis, so no counts are lost." vertex="1">
          <mxGeometry height="70" width="690" x="660" y="185" as="geometry" />
        </mxCell>
        <mxCell id="r2_40" parent="1" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacing=6;fontSize=11;fontStyle=1;" value="A backend server keeps failing" vertex="1">
          <mxGeometry height="70" width="230" x="40" y="265" as="geometry" />
        </mxCell>
        <mxCell id="r2_290" parent="1" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacing=6;fontSize=11;" value="Requests to it time out or return errors" vertex="1">
          <mxGeometry height="70" width="350" x="290" y="265" as="geometry" />
        </mxCell>
        <mxCell id="r2_660" parent="1" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacing=6;fontSize=11;" value="Its circuit breaker opens; the router uses other servers; Half-Open tests bring it back when healthy." vertex="1">
          <mxGeometry height="70" width="690" x="660" y="265" as="geometry" />
        </mxCell>
        <mxCell id="r3_40" parent="1" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacing=6;fontSize=11;fontStyle=1;" value="All servers of one service are down" vertex="1">
          <mxGeometry height="70" width="230" x="40" y="345" as="geometry" />
        </mxCell>
        <mxCell id="r3_290" parent="1" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacing=6;fontSize=11;" value="No healthy target to send to" vertex="1">
          <mxGeometry height="70" width="350" x="290" y="345" as="geometry" />
        </mxCell>
        <mxCell id="r3_660" parent="1" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacing=6;fontSize=11;" value="The router returns 503 quickly instead of making clients wait." vertex="1">
          <mxGeometry height="70" width="690" x="660" y="345" as="geometry" />
        </mxCell>
        <mxCell id="r4_40" parent="1" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacing=6;fontSize=11;fontStyle=1;" value="Message queue or analytics is slow or down" vertex="1">
          <mxGeometry height="70" width="230" x="40" y="425" as="geometry" />
        </mxCell>
        <mxCell id="r4_290" parent="1" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacing=6;fontSize=11;" value="Dashboard is late or has gaps" vertex="1">
          <mxGeometry height="70" width="350" x="290" y="425" as="geometry" />
        </mxCell>
        <mxCell id="r4_660" parent="1" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacing=6;fontSize=11;" value="Events are sent asynchronously after the response, so client requests are not affected." vertex="1">
          <mxGeometry height="70" width="690" x="660" y="425" as="geometry" />
        </mxCell>
        <mxCell id="r5_40" parent="1" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacing=6;fontSize=11;fontStyle=1;" value="Config DB is down" vertex="1">
          <mxGeometry height="70" width="230" x="40" y="505" as="geometry" />
        </mxCell>
        <mxCell id="r5_290" parent="1" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacing=6;fontSize=11;" value="New keys and limits cannot be loaded" vertex="1">
          <mxGeometry height="70" width="350" x="290" y="505" as="geometry" />
        </mxCell>
        <mxCell id="r5_660" parent="1" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacing=6;fontSize=11;" value="Auth uses its local cache of recent keys and policies, so existing clients keep working." vertex="1">
          <mxGeometry height="70" width="690" x="660" y="505" as="geometry" />
        </mxCell>
        <mxCell id="r6_40" parent="1" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacing=6;fontSize=11;fontStyle=1;" value="Traffic goes above 500 requests/sec" vertex="1">
          <mxGeometry height="70" width="230" x="40" y="585" as="geometry" />
