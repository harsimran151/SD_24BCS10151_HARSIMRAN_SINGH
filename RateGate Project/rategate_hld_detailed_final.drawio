<mxfile host="app.diagrams.net" pages="4">
  <diagram name="1. Architecture" id="arch">
    <mxGraphModel dx="866" dy="472" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;" value="RateGate: High Level Design (request flow through each service)" vertex="1">
          <mxGeometry height="35" width="1200" x="20" y="5" as="geometry" />
        </mxCell>
        <mxCell id="frF" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;fontColor=#000000;sketch=1;curveFitting=1;jiggle=1;" value="Functional requirements  &lt;font color=&quot;#7a5590&quot;&gt;&lt;b&gt;[M1]&lt;/b&gt;&lt;/font&gt; &lt;font color=&quot;#5f8f49&quot;&gt;&lt;b&gt;[M2]&lt;/b&gt;&lt;/font&gt; &lt;font color=&quot;#b07800&quot;&gt;&lt;b&gt;[M3]&lt;/b&gt;&lt;/font&gt; = owner" vertex="1">
          <mxGeometry height="215" width="400" x="20" y="95" as="geometry" />
        </mxCell>
        <mxCell id="tF" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;verticalAlign=top;" value="FR1  Issue and validate API keys &lt;font color=&quot;#b07800&quot;&gt;&lt;b&gt;[M3]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;FR2  Plan per client, Free 10/min and Pro 100/min &lt;font color=&quot;#b07800&quot;&gt;&lt;b&gt;[M3]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;FR3  Token bucket throttle, 429 with Retry-After &lt;font color=&quot;#7a5590&quot;&gt;&lt;b&gt;[M1]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;FR4  X-RateLimit-Remaining header on success &lt;font color=&quot;#7a5590&quot;&gt;&lt;b&gt;[M1]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;FR5  Round-robin routing to healthy backends &lt;font color=&quot;#5f8f49&quot;&gt;&lt;b&gt;[M2]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;FR6  Regular health checks, skip unhealthy backends &lt;font color=&quot;#5f8f49&quot;&gt;&lt;b&gt;[M2]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;FR7  Circuit breaker, 503 when no backend is left &lt;font color=&quot;#5f8f49&quot;&gt;&lt;b&gt;[M2]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;FR8  Live dashboard: allowed and rejected per client,&lt;br&gt;        backend health &lt;font color=&quot;#b07800&quot;&gt;&lt;b&gt;[M3]&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="175" width="380" x="30" y="125" as="geometry" />
        </mxCell>
        <mxCell id="frN" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;fontColor=#000000;sketch=1;curveFitting=1;jiggle=1;" value="Non-functional requirements" vertex="1">
          <mxGeometry height="300" width="400" x="20" y="325" as="geometry" />
        </mxCell>
        <mxCell id="tN" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;verticalAlign=top;" value="&lt;b&gt;NFR1  Low latency:&lt;/b&gt; under 10 ms added at p95 (about 4 ms estimated)&lt;br&gt;&lt;br&gt;&lt;b&gt;NFR2  High availability:&lt;/b&gt; 99.9%, 2 gateway instances and a Redis replica&lt;br&gt;&lt;br&gt;&lt;b&gt;NFR3  Scalability:&lt;/b&gt; add capacity by adding instances, the gateway is stateless&lt;br&gt;&lt;br&gt;&lt;b&gt;NFR4  Accuracy under concurrency:&lt;/b&gt; atomic Lua script, no request slips past the limit&lt;br&gt;&lt;br&gt;&lt;b&gt;NFR5  Fault tolerance:&lt;/b&gt; fail-open limiter, one retry, 503 fallback&lt;br&gt;&lt;br&gt;&lt;b&gt;NFR6  Observability:&lt;/b&gt; allowed, rejected and backend health shown live&lt;br&gt;&lt;br&gt;&lt;b&gt;Target load:&lt;/b&gt; 100 req/s average, 500 req/s peak" vertex="1">
          <mxGeometry height="265" width="380" x="30" y="355" as="geometry" />
        </mxCell>
        <mxCell id="client" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fontSize=10;sketch=1;curveFitting=1;jiggle=1;" value="&lt;b&gt;Clients&lt;/b&gt;&lt;br&gt;web, mobile, partner apps" vertex="1">
          <mxGeometry height="50" width="140" x="450" y="100" as="geometry" />
        </mxCell>
        <mxCell id="lb" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fontSize=10;sketch=1;curveFitting=1;jiggle=1;" value="&lt;b&gt;Load Balancer&lt;/b&gt;&lt;br&gt;spreads traffic, health checks, removes dead gateways" vertex="1">
          <mxGeometry height="61" width="140" x="450" y="177" as="geometry" />
        </mxCell>
        <mxCell id="admin" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fontSize=11;sketch=1;curveFitting=1;jiggle=1;" value="&lt;b&gt;Admin / Ops&lt;/b&gt;" vertex="1">
          <mxGeometry height="50" width="140" x="450" y="325" as="geometry" />
        </mxCell>
        <mxCell id="cluster" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;fontColor=#000000;dashed=1;dashPattern=8 6;sketch=1;curveFitting=1;jiggle=1;" value="RateGate Gateway Cluster: Instance 1 ... N (stateless, add more to scale)" vertex="1">
          <mxGeometry height="765" width="1355" x="630" y="95" as="geometry" />
        </mxCell>
        <mxCell id="lane1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8ee;strokeColor=#d79b00;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;fontColor=#b07800;sketch=1;curveFitting=1;jiggle=1;" value="(1) Auth and Config Service  [Member 3]" vertex="1">
          <mxGeometry height="135" width="1305" x="655" y="135" as="geometry" />
        </mxCell>
        <mxCell id="lane2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f1fa;strokeColor=#9673a6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;fontColor=#7a5590;sketch=1;curveFitting=1;jiggle=1;" value="(2) Rate Limiter Service, token bucket  [Member 1]" vertex="1">
          <mxGeometry height="135" width="1305" x="655" y="450" as="geometry" />
        </mxCell>
        <mxCell id="lane3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f1f8ef;strokeColor=#82b366;strokeWidth=2;verticalAlign=top;align=right;spacingRight=10;spacingTop=4;fontStyle=1;fontSize=12;fontColor=#5f8f49;sketch=1;curveFitting=1;jiggle=1;" value="(3) Router and Circuit Breaker  [Member 2]" vertex="1">
          <mxGeometry height="195" width="1305" x="655" y="615" as="geometry" />
        </mxCell>
        <mxCell id="a0" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;strokeWidth=2;fontSize=10;sketch=1;curveFitting=1;jiggle=1;" value="Read API key / token from the request header" vertex="1">
          <mxGeometry height="75" width="150" x="680" y="170" as="geometry" />
        </mxCell>
        <mxCell id="a1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;strokeWidth=2;fontSize=10;sketch=1;curveFitting=1;jiggle=1;" value="Check key (local cache first, then Config DB)" vertex="1">
          <mxGeometry height="75" width="150" x="958" y="170" as="geometry" />
        </mxCell>
        <mxCell id="a2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;strokeWidth=2;fontSize=10;sketch=1;curveFitting=1;jiggle=1;" value="Load client policy: rate, burst size, allowed routes" vertex="1">
          <mxGeometry height="75" width="150" x="1235" y="170" as="geometry" />
        </mxCell>
        <mxCell id="a3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;strokeWidth=2;fontSize=10;sketch=1;curveFitting=1;jiggle=1;" value="Invalid or blocked key: stop with 401 / 403" vertex="1">
          <mxGeometry height="75" width="150" x="1513" y="170" as="geometry" />
        </mxCell>
        <mxCell id="a4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;strokeWidth=2;fontSize=10;sketch=1;curveFitting=1;jiggle=1;" value="Pass client_id + policy to the next step" vertex="1">
          <mxGeometry height="75" width="150" x="1790" y="170" as="geometry" />
        </mxCell>
        <mxCell id="r0" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=2;fontSize=10;sketch=1;curveFitting=1;jiggle=1;" value="Build counter name: client_id + route" vertex="1">
          <mxGeometry height="75" width="150" x="1790" y="485" as="geometry" />
        </mxCell>
        <mxCell id="r1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=2;fontSize=10;sketch=1;curveFitting=1;jiggle=1;" value="Run ONE atomic script in Redis (no race between instances)" vertex="1">
          <mxGeometry height="75" width="150" x="1513" y="485" as="geometry" />
        </mxCell>
        <mxCell id="r2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=2;fontSize=10;sketch=1;curveFitting=1;jiggle=1;" value="Refill: tokens + time passed x rate (never above burst)" vertex="1">
