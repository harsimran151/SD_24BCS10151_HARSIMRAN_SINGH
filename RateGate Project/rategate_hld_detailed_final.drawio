        </mxCell>
        <mxCell id="r6_660" parent="1" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacing=6;fontSize=11;" value="Add more gateway instances (they are stateless). The rate limiter keeps backends protected meanwhile." vertex="1">
