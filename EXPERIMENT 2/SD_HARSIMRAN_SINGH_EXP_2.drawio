        </mxCell>
        <mxCell id="Y0tpEwrIhtBrovRxQJvd-47" parent="1" style="text;whiteSpace=wrap;" value="Total Requests per Day = DAU × Requests per user per day = 100 Million × 50 = 5 Billion requests/day" vertex="1">
