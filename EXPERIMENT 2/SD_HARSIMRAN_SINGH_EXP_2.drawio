        <mxCell id="Y0tpEwrIhtBrovRxQJvd-44" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;table&gt;&lt;thead&gt;&lt;tr&gt;&lt;th&gt;Parameter&lt;/th&gt;&lt;th align=&quot;right&quot;&gt;Assumption&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td&gt;Daily Active Users (DAU)&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;&lt;strong&gt;100 Million&lt;/strong&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Average sessions per user/day&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;&lt;strong&gt;2&lt;/strong&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Average session duration&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;&lt;strong&gt;1 hour&lt;/strong&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Peak traffic percentage&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;&lt;strong&gt;20%&lt;/strong&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;API requests per user/day&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;&lt;strong&gt;50&lt;/strong&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" vertex="1">
