        </mxCell>
        <mxCell id="Y0tpEwrIhtBrovRxQJvd-45" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;table&gt;&lt;thead&gt;&lt;tr&gt;&lt;th&gt;Parameter&lt;/th&gt;&lt;th align=&quot;right&quot;&gt;Assumption&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td&gt;Average video size (1 hour, HD)&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;&lt;strong&gt;1.5 GB&lt;/strong&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Average bitrate&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;&lt;strong&gt;4 Mbps&lt;/strong&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Percentage of HD streams&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;&lt;strong&gt;70%&lt;/strong&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Total videos in catalog&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;&lt;strong&gt;10,000&lt;/strong&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;br&gt;&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;&lt;br&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" vertex="1">
